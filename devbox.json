{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "vals@0.43.7",
    "path:gcloud#google-cloud-sdk",
    "jq@1.8.1",
    "curl@8.17.0",
    "qrencode@4.1.1",
    "imagemagick@7.1.2-27"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "eval \"$(vals env -export -f .env.vals.yaml)\" 2>/dev/null || true",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "agent": ["claude --continue"],
      "agent-new": ["claude"],
      "slides-browser": [
        "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/node_modules/.cache/ms-playwright\" npx --yes playwright@1.61.1 install chromium"
      ]
    }
  }
}
